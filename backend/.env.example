APP_NAME="Goat Marketplace"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kathmandu
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=goat_marketplace
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Brevo (SMTP relay). Flip MAIL_MAILER to `smtp` once the key below is filled
# in — leaving it as `log` means every notification is written to
# storage/logs/laravel.log instead of being sent, which is where they have all
# been going so far.
#
# MAIL_USERNAME is the Brevo SMTP login (an address like 9a1b2c@smtp-brevo.com),
# NOT the account email. MAIL_PASSWORD is the SMTP key from
# Brevo > SMTP & API > SMTP. MAIL_FROM_ADDRESS must be a sender Brevo has
# verified, or it rejects the message.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="orders@goathaven.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google sign-in (Google Identity Services).
# Only the client id is needed: the browser gets an ID token and the API verifies
# its signature against Google public keys, so there is no secret to exchange.
# The same value goes in frontend/.env.local as NEXT_PUBLIC_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
# Optional, local development only. Set to a ca-bundle.crt path if HTTPS calls
# from PHP fail with "unable to get local issuer certificate". Leave empty in production.
GOOGLE_CA_BUNDLE=

# Google reCAPTCHA v2 (checkbox), from https://www.google.com/recaptcha/admin
# Register the site as reCAPTCHA v2 -> "I am not a robot" Checkbox, and add
# localhost plus your production domain to its domain list.
# The site key is public and also goes in frontend/.env.local as
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY. The secret key must never reach the browser.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Payment gateways.
#
# eSewa's sandbox values below are the ones eSewa publishes for testing; they
# are not credentials. Khalti has no shared key -- get one from
# test-admin.khalti.com for sandbox, admin.khalti.com for live. Leaving it
# blank simply hides Khalti at checkout rather than offering a method that
# cannot open a payment.
ESEWA_MODE=sandbox
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET="8gBm/:&EnhH.1/q"
KHALTI_MODE=sandbox
KHALTI_SECRET_KEY=
